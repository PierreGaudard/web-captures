// Maquette AMV : AMV - Assurance moto hivernage (creation) (gabarit amv-moto-tous-risques, contenu du gabarit masque).
// Page proposee : /assurance-moto/assurance-moto-hivernage/
(function(){
  var H1="Assurance moto pendant l'hivernage", BODY=[{"p": "En résumé, une assurance moto hivernage n'existe pas comme produit séparé, mais votre contrat prévoit une suspension de ses effets quand la machine ne roule plus. La Responsabilité civile reste obligatoire tant que la moto est immatriculée, y compris au garage. Le vol et l'incendie sont les vrais risques de la période hivernale, alors que le risque routier disparaît. Découvrez quels arbitrages font baisser la cotisation sans laisser la moto sans protection."}, {"p": "Une moto qui dort six mois au garage reste une moto assurée. C'est le premier réflexe à corriger chez beaucoup de motards, qui pensent qu'une machine immobilisée sort mécaniquement du champ de l'assurance. L'obligation d'assurance suit le véhicule, pas son usage. Tant que la moto est immatriculée et qu'elle n'a pas été retirée de la circulation, la Responsabilité civile reste due, même quand la batterie est débranchée et la housse posée."}, {"p": "Cela ne veut pas dire payer une cotisation pleine pour un véhicule qui ne roule pas. Voici ce que permet votre contrat assurance moto pendant la période hivernale, ce qui reste couvert quand la moto est remisée, et comment faire des économies sans prendre de risque."}, {"h2": "Faut-il garder son assurance moto hivernage ?"}, {"p": "Oui. L'article L211-1 du code des assurances impose une assurance de responsabilité civile à qui veut faire circuler un véhicule terrestre à moteur, défini comme tout véhicule automoteur destiné à circuler sur le sol. Le texte ne distingue pas la voie publique du terrain privé, et une machine immatriculée en état de rouler reste dans ce champ. Seule une sortie officielle de la circulation l'en ferait sortir. Une moto stationnée dans un garage fermé peut d'ailleurs causer un dommage, par exemple si elle tombe sur le véhicule du voisin ou si un incendie d'origine électrique se déclare. Le fait de ne plus l'utiliser ne change rien à cette obligation. Dans ces situations, c'est la Responsabilité civile qui répond, et vous restez responsable si elle n'est plus en vigueur."}, {"p": "Résilier son contrat en novembre pour souscrire assurance à nouveau en mars est une fausse bonne idée. Vous perdez l'antériorité de votre contrat, vous laissez la moto sans protection contre le vol et l'incendie au moment où elle est la plus vulnérable, et une interruption dans votre historique ne joue jamais en votre faveur."}, {"p": "La bonne question n'est pas de savoir s'il faut rester assuré, mais quel niveau de couverture correspond à vos besoins quand la moto ne roule plus."}, {"h2": "Suspendre assurance moto, ce que permet le contrat"}, {"p": "Suspendre une assurance moto n'est pas la résilier. Les conditions générales AMV prévoient une suspension des effets du contrat, qui met provisoirement fin non pas au contrat, qui continue d'exister, mais à ses effets. Le contrat reste vivant, votre antériorité est préservée, et la reprise se fait sans nouvelle souscription au printemps. Les garanties sont suspendues, pas supprimées, et c'est tout l'avantage du dispositif."}, {"p": "C'est ce mécanisme que les motards appellent le garage mort. Il répond à une situation simple, une moto remisée plusieurs mois d'affilée, sans aucune utilisation sur la route. Deux conditions comptent vraiment. La moto doit être stockée dans un lieu clos, un garage, un box ou une remise fermée à clé. Et elle ne doit pas circuler, pas même pour un aller-retour au contrôle technique ou chez le concessionnaire, sous peine de rouler sans garantie."}, {"p": "La durée minimale de suspension et le traitement de la cotisation dépendent de votre contrat. Un conseiller AMV précise ce qui s'applique avant que vous engagiez la démarche."}, {"h2": "Ce qui reste couvert quand la moto dort au garage"}, {"p": "Une moto immobilisée n'échappe pas aux sinistres, elle en change la nature. Le risque routier disparaît, celui du vol reste entier, et c'est bien lui qu'il faut protéger. La sécurité du lieu de remisage devient donc le critère central. Un deux-roues immobilisé plusieurs semaines dans un garage collectif, sans que personne s'en approche, est une cible plus facile qu'une machine utilisée tous les jours."}, {"p": "Chez AMV, le vol dans un local privé fermé à clé est garanti dès la formule RC, Vol et Incendie, sous réserve d'effraction, d'escalade, d'usage de fausses clés ou de fausses cartes magnétiques. L'indemnisation se fait alors en valeur de remplacement à dire d'expert. Le vandalisme est couvert sous réserve de dépôt de plainte."}, {"p": "Un point mérite l'attention avant de remiser, la franchise vol est divisée par 2 si votre moto est équipée d'un gravage et d'un antivol agréé SRA. Sur une machine qui passe l'hiver dans un box collectif, ces deux équipements changent le reste à charge."}, {"p": "Au-dessus, la formule Dommages collision indemnise les dommages subis par votre moto, déduction faite, en cas de sinistre responsable, de la franchise prévue au contrat. La formule Tous risques élargit aux dommages subis quelle qu'en soit l'origine, y compris les attentats et les catastrophes naturelles."}, {"p": "C'est là que se joue l'arbitrage d'une assurance moto hivernage. Le tableau ci-dessous récapitule les garanties acquises selon la formule choisie, chaque formule reprenant l'intégralité de la précédente."}, {"table": {"head": ["<tr><th>Formule", "Dommages causés aux tiers", "Casque, gants, gilet airbag (vétusté déduite)", "Défense pénale et recours suite à accident et Protection juridique (jusqu'à 20 000 € au total)", "Vol et Incendie", "Dommages collision", "Dommages tous accidents"], "rows": [["Responsabilité civile", "oui", "oui", "oui", "non", "non", "non"], ["RC, Vol et Incendie", "oui", "oui", "oui", "oui", "non", "non"], ["Dommages collision", "oui", "oui", "oui", "oui", "oui", "non"], ["Tous risques", "oui", "oui", "oui", "oui", "oui", "oui"]]}}, {"p": "La Responsabilité civile couvre les dommages causés aux tiers lors d'un sinistre responsable. C'est le minimum obligatoire pour rouler sur la route tout en maîtrisant son budget. Dès cette première formule, le casque jusqu'à 250 euros, les gants jusqu'à 70 euros et le gilet airbag jusqu'à 500 euros sont pris en charge en cas de sinistre. Pour une moto qui passe l'hiver dans un box, la question se pose autrement, puisque le risque à couvrir devient le vol et l'incendie plutôt que l'accident de circulation."}, {"p": "L'arbitrage revient chaque automne. Sur une machine récente, descendre en Responsabilité civile seule pendant l'hiver laisse sans protection le moment où le vol est le plus probable. Sur une machine de faible valeur remisée dans un garage individuel, la logique peut s'inverser."}, {"h2": "Bien remiser sa moto avant l'hiver"}, {"p": "Le stockage conditionne l'état de la machine au printemps et pèse sur le risque couvert. Quelques gestes suffisent, une demi-journée."}, {"ul": ["Faites le plein avant de remiser, avec un stabilisateur de carburant. Un réservoir plein laisse moins de place à la condensation.", "Nettoyez, séchez, puis graissez la chaîne. Le sel et l'humidité travaillent tout l'hiver.", "Débranchez la batterie ou branchez un chargeur de maintien, sinon elle se sulfate en quelques semaines.", "Surélevez la moto sur béquille d'atelier. Des roues qui portent tout le poids plusieurs mois se déforment.", "Vidangez le moteur si l'échéance approche, une huile usagée est chargée en résidus acides.", "Couvrez avec une housse respirante, jamais une bâche plastique qui emprisonne l'humidité."]}, {"p": "Nos conseils pour [[LINK:https://www.amv.fr/assurance-moto/sortir-sa-moto-de-lhivernage/]]sortir sa moto de l'hivernage[[/LINK]] détaillent la remise en route au printemps."}, {"h2": "Combien coûte une assurance moto pendant la période hivernale ?"}, {"p": "Il n'existe pas de tarif unique. Le coût d'une assurance moto dépend du modèle, de la sinistralité déclarée, du lieu de stationnement, du niveau de couverture retenu et de l'antériorité du permis."}, {"p": "Sur une assurance moto hivernage, à profil identique, le lieu de stationnement pèse plus lourd. Une moto remisée dans un garage fermé n'expose pas au même risque qu'une machine laissée sur la voie publique six mois d'affilée, et cela se traduit dans le tarif. Si vous avez déménagé ou changé de mode de stationnement depuis votre souscription, signalez-le, c'est un renseignement qui joue en votre faveur."}, {"p": "Deux leviers permettent de bénéficier d'une cotisation plus basse sans dégrader la protection. Ajuster le niveau de garanties à la valeur de la machine, à sa fréquence d'utilisation et à votre budget, plutôt que de conserver par défaut la formule souscrite au moment de l'achat. Et regrouper vos deux-roues sur un seul contrat si vous possédez une moto et un scooter, une réduction s'appliquant alors sur le second véhicule. AMV propose jusqu'à quatre formules, selon les modèles, ce qui laisse de la marge pour ajuster sans tout changer."}, {"p": "Pour connaître votre tarif, le plus rapide reste d'établir un [[LINK:https://www.amv.fr/assurance/moto/]]devis assurance moto[[/LINK]] en ligne. Permis, carte grise et relevé d'information ne sont pas des pièces à fournir, ce sont les renseignements qu'ils contiennent qui sont nécessaires pour établir votre tarif. La souscription demande donc peu de justificatifs, et vous suivez ensuite votre contrat depuis Mon Espace AMV."}, {"h2": "Pourquoi assurer votre moto en hivernage chez AMV ?"}, {"p": "AMV est spécialiste de l'assurance deux-roues, fondée en 1974 par un passionné de moto, pour les motards, et compte plus d'1 million d'assurés. La question de l'hivernage revient chaque automne, et la réponse diffère selon que vous rangez un roadster de 2024 dans un box collectif ou une machine de collection dans une grange. Plus de 350 conseillers traitent ces cas, et les avantages d'un assureur spécialisé se voient sur ces situations de bord. Notre note de satisfaction est de 4,7 sur 5 sur Avis Vérifiés."}, {"p": "Trois options complémentaires dédiées au pilote et aux équipements méritent l'attention quand la moto reprend la route au printemps."}, {"ul": ["L'Individuelle Pilote permet le versement d'un capital, jusqu'à 800 000 euros, en cas de déficit fonctionnel permanent, ou aux ayants droit en cas de décès.", "L'Option Plus indemnise votre moto en valeur d'achat pendant un an et demi et étend la couverture aux accessoires hors-série, dans la limite de 5 000 €.", "L'Assistance 0 km intervient dès le premier tour de roue, y compris pour une panne à la sortie du garage après plusieurs mois d'immobilisation, moment où les pannes de batterie et d'alimentation sont les plus fréquentes."]}, {"p": "Sur une machine remisée dans un garage individuel et bien protégée, une formule RC, Vol et Incendie peut suffire pendant les mois d'hiver. Sur un box collectif partagé, l'arbitrage serait différent."}, {"p": "Vous retrouvez nos garanties par situation sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-type/]]assurance moto par type[[/LINK]], et nos contenus par marque sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-constructeur/]]assurance moto par constructeur[[/LINK]]."}], FAQ=[{"h2": "Questions fréquentes sur l'assurance moto en hivernage"}, {"h3": "Peut-on résilier son assurance moto pour l'hiver et la reprendre au printemps ?"}, {"p": "C'est possible mais rarement pertinent. Vous perdez l'antériorité du contrat, la moto reste sans garantie contre le vol pendant tout l'hiver, et l'obligation d'assurance continue de s'appliquer tant que le véhicule est immatriculé. La suspension des effets du contrat répond mieux au besoin, puisqu'elle conserve le contrat en vie."}, {"h3": "Que se passe-t-il si ma moto est volée dans mon garage pendant l'hivernage ?"}, {"p": "Le vol dans un local privé fermé à clé est garanti à partir de la formule RC, Vol et Incendie, sous réserve d'effraction, d'escalade ou d'usage de fausses clés. Si vous n'avez conservé que la Responsabilité civile pendant l'hiver, le vol n'est pas couvert. C'est l'arbitrage principal à faire avant de remiser."}, {"h3": "Puis-je sortir ma moto une fois pendant la suspension ?"}, {"p": "Non. Pendant une suspension des effets du contrat, la moto ne doit pas circuler, y compris pour un trajet court vers un garage ou un contrôle technique. Un tel déplacement se ferait sans garantie et engagerait votre responsabilité personnelle."}, {"h3": "L'hivernage fait-il baisser le prix de mon assurance moto ?"}, {"p": "Pas automatiquement, car la cotisation est calculée sur l'année. En revanche le lieu de stationnement compte dans le tarif, et le passage à une formule adaptée à un véhicule remisé plusieurs mois génère des économies réelles. Un conseiller AMV chiffre l'écart sur votre contrat."}, {"h3": "Existe-t-il une assurance moto saisonnière ?"}, {"p": "Certains assureurs commercialisent une assurance moto saisonnière, avec une cotisation réduite pendant les mois d'immobilisation. Chez AMV, une moto saisonnière se traite par l'ajustement des garanties et par la suspension des effets du contrat, à voir avec votre conseiller selon la durée de remisage."}, {"h3": "Une moto scooter au garage suit-elle les mêmes règles ?"}, {"p": "Oui, l'obligation et le mécanisme de suspension sont identiques pour une moto scooter remisée. La différence est pratique, un scooter urbain sert souvent toute l'année alors qu'une moto de loisir est remisée. Les règles d'une assurance moto hivernage valent donc pour les deux, et notre [[LINK:https://www.amv.fr/assurance/scooter/]]assurance scooter[[/LINK]] suit la même logique."}], STRIKE=["Assurance Moto Assurance Scooter Assurance Quad Assurance An","Comme pour les autres typologies d’assurance moto, le tarif ","Selon les caractéristiques de votre moto et les garanties so","Comment assurer sa moto ?","Bien assurer votre moto est essentiel pour prendre la route ","AMV propose la souscription simple et rapide en ligne vous p","AMV propose une gamme complète de formules d'assurance moto ","En cas de sinistre, AMV met à votre disposition un service d","Experts de l'assurance moto, les conseillers AMV sont des pa","En choisissant AMV comme assureur pour votre moto , vous bén","Quelle assurance moto choisir ?","Quel est le prix d'une assurance moto ?","Quelle formule assurance moto choisir ?","Comment obtenir un devis d'assurance moto ?","Pour obtenir un devis d'assurance moto rapidement, AMV est v","Assurance moto comparatif"], OFFTOPIC=[];
  function norm(s){return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[\u2019\u2018\u02bc\u0060\u00b4\u2032]/g,"'").replace(/\s+/g," ");}
  function lnk(s){return (s||"").replace(/\[\[LINK:([^\]]*)\]\]([\s\S]*?)\[\[\/LINK\]\]/g,'<a href="$1" target="_blank" rel="noopener">$2</a>');}
  function el(tag,cls,h){var e=document.createElement(tag);if(cls)e.className=cls;if(h!=null)e.innerHTML=h;return e;}
  function renderItems(items){var frag=document.createDocumentFragment();items.forEach(function(it){
    if(it.h2)frag.appendChild(el("h2","rl-nh rl-nh2",lnk(it.h2)));
    else if(it.h3)frag.appendChild(el("h3","rl-nh rl-nh3",lnk(it.h3)));
    else if(it.p)frag.appendChild(el("p","rl-np",lnk(it.p)));
    else if(it.note){var c=el("div","rl-callout",null);c.appendChild(el("span","rl-callout-ic","✓"));c.appendChild(el("span","rl-callout-tx",lnk(it.note)));frag.appendChild(c);}
    else if(it.cta){var a=el("a","rl-cta",it.cta.label);a.setAttribute("href",it.cta.href);a.setAttribute("target","_blank");a.setAttribute("rel","noopener");frag.appendChild(a);}
    else if(it.ul){var ul=el("ul","rl-nul",null);it.ul.forEach(function(li){ul.appendChild(el("li",null,lnk(li)));});frag.appendChild(ul);}
    else if(it.table){var t=el("table","rl-table",null);var th=el("thead",null,null),tr=el("tr",null,null);it.table.head.forEach(function(h){tr.appendChild(el("th",null,h));});th.appendChild(tr);t.appendChild(th);var tb=el("tbody",null,null);it.table.rows.forEach(function(r){var row=el("tr",null,null);r.forEach(function(c){row.appendChild(el("td",null,c));});tb.appendChild(row);});t.appendChild(tb);frag.appendChild(t);}
  });return frag;}
  function block(items){var box=el("div","rl-add",null);box.appendChild(el("span","rl-badge","Nouvelle page proposee"));box.appendChild(renderItems(items));return box;}
  function findByText(sel,text){var n=norm(text);var l=[].slice.call(document.querySelectorAll(sel));for(var i=0;i<l.length;i++){if(norm(l[i].textContent).indexOf(n)>=0)return l[i];}return null;}
  function insertAfter(node,ref){ref.parentNode.insertBefore(node,ref.nextSibling);}
  function insertBefore(node,ref){ref.parentNode.insertBefore(node,ref);}
  function apply(){
    var h1=document.querySelector("h1");
    if(H1&&h1&&!h1.getAttribute("data-rl")){h1.setAttribute("data-rl","1");var nh=el("div","rl-add rl-inline",null);nh.id="rl-h1box";nh.appendChild(el("span","rl-badge","H1 propose"));nh.appendChild(el("span","rl-h1",H1));insertAfter(nh,h1);}
    if(h1&&!document.getElementById("rl-body")){var bb=block(BODY);bb.id="rl-body";var hero=h1.closest(".gap-amv40")||h1.closest("section")||h1.closest(".umb-block-list")||h1;insertAfter(bb,hero);}
    if(FAQ&&FAQ.length&&!document.getElementById("rl-faq")){
      var af=findByText("h2","questions fr");
      var bf=block(FAQ);bf.id="rl-faq";
      if(af){var fs=af.closest("section")||af;insertBefore(bf,fs);}
      else{var b=document.getElementById("rl-body");if(b)insertAfter(bf,b);}
    }
    if(!window.__rlStruck){var n=0;var faqH=findByText("h2","questions fr");[].slice.call(document.querySelectorAll("h2,h3,h4,p,li")).forEach(function(e){
      if(e.closest(".rl-add"))return;
      /* creation : la FAQ existante du template est masquee elle aussi */
      var t=norm(e.textContent);
      for(var i=0;i<STRIKE.length;i++){if(STRIKE[i]&&t.indexOf(norm(STRIKE[i]))>=0){e.style.display="none";n++;break;}}
    });if(n)window.__rlStruck=true;}
    if(OFFTOPIC&&OFFTOPIC.length&&!window.__rlOff){var faqH2=findByText("h2","questions fr");if(faqH2){var m=0;[].slice.call(document.querySelectorAll("h2,h3,p,li,span,.collapse-part")).forEach(function(e){if(e.closest(".rl-add"))return;if(e.closest(".rl-offtopic"))return;if(!(faqH2===e||(faqH2.compareDocumentPosition(e)&4)))return;var t=norm(e.textContent);for(var j=0;j<OFFTOPIC.length;j++){if(OFFTOPIC[j]&&t.indexOf(norm(OFFTOPIC[j]))>=0){e.classList.add("rl-offtopic");m++;break;}}});if(m)window.__rlOff=true;}}

    /* --- mode creation --- */
    var box=document.querySelector("main > div.mx-auto");
    if(box&&!window.__rlCrea){
      var kids=[].slice.call(box.children);
      kids.forEach(function(k,i){
        if(i<2)return;                            /* fil d'ariane + hero */
        if(k.classList.contains("rl-add"))return; /* notre contenu */
        if(k.querySelector&&k.querySelector(".rl-add"))return;
        if(i===kids.length-1)return;              /* pagination de bas de page */
        k.classList.add("rl-del");
      });
      var hh=document.querySelector("h1");
      if(hh&&H1){hh.textContent=H1;}
      var bc=box.children[0];
      if(bc){var last=bc.lastElementChild;if(last)last.textContent=H1;}
      if(H1)document.title=H1+" | AMV";
      var hb=document.getElementById("rl-h1box");if(hb)hb.style.display="none";
      /* le visuel de marque du gabarit n'a rien a faire sur une autre marque */
      var hero=hh?(hh.closest(".gap-amv40")||hh.parentElement.parentElement):null;
      if(hero){[].slice.call(hero.querySelectorAll("img,picture")).forEach(function(im){im.classList.add("rl-del");});}
      window.__rlCrea=true;
    }
    return !!(h1&&document.getElementById("rl-body"));
  }
  function addControls(){if(document.getElementById("rl-toggle"))return;var b=el("button",null,'<span class="dot"></span> Voir les modifications');b.id="rl-toggle";b.addEventListener("click",function(){var d=document.body,on=d.classList.toggle("rl-on");d.classList.toggle("rl-final",!on);b.innerHTML='<span class="dot"></span> '+(on?"Version finale":"Voir les modifications");});document.body.appendChild(b);var lg=el("div",null,'<span class="sw sw-add"></span> Nouvelle page proposee (creation, template AMV)');lg.id="rl-legend";document.body.appendChild(lg);document.body.classList.add("rl-final");}
  function init(){addControls();var t=0;var tm=setInterval(function(){t++;if(apply()||t>40){clearInterval(tm);}},250);}
  if(document.readyState==="complete"||document.readyState==="interactive")init();else document.addEventListener("DOMContentLoaded",init);
})();

/* --- correctif scroll (ajoute le 2026-08-20) ---------------------------------
   Un script du site ajoute la classe `tc-modal-open` au body au chargement.
   La regle `body.tc-modal-open{inset:0;position:fixed;overflow:hidden}` verrouille
   alors le scroll, alors qu'aucune modale n'existe dans la capture. On retire la
   classe, on neutralise la regle, et un observer la retire si un script la remet. */
(function(){
  var css=document.createElement('style');
  css.textContent='body.tc-modal-open{position:static !important;inset:auto !important;overflow:visible !important;height:auto !important;}';
  (document.head||document.documentElement).appendChild(css);
  function unlock(){
    var b=document.body; if(!b) return;
    b.classList.remove('tc-modal-open');
    if(getComputedStyle(b).position==='fixed'){ b.style.setProperty('position','static','important'); b.style.setProperty('overflow','visible','important'); b.style.setProperty('height','auto','important'); }
  }
  function watch(){
    unlock();
    try{ new MutationObserver(unlock).observe(document.body,{attributes:true,attributeFilter:['class','style']}); }catch(e){}
  }
  if(document.body) watch(); else document.addEventListener('DOMContentLoaded',watch);
  window.addEventListener('load',unlock);
  setTimeout(unlock,1500); setTimeout(unlock,4000);
})();
