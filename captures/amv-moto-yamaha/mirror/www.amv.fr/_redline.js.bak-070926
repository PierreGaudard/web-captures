// Maquette AMV : AMV - Assurance moto Yamaha (reoptimisation) (gabarit amv-moto-bmw, contenu du gabarit masque).
// Page proposee : /assurance-moto/assurance-moto-yamaha/
(function(){
  var H1="Assurance moto Yamaha", BODY=[{"p": "En résumé, une assurance moto Yamaha se choisit d'abord selon le modèle et sa valeur. Une MT-125 de jeune permis et une R1 de 200 chevaux ne relèvent pas du même niveau de protection, alors que la marque est la même. AMV propose jusqu'à quatre formules, selon les modèles, et une offre construite pour toute la gamme, du roadster au trail. Découvrez quel tarif s'applique à votre machine et comment obtenir votre devis en ligne."}, {"h2": "Une gamme large, des besoins d'assurance très différents"}, {"p": "Yamaha couvre à peu près tout le spectre du deux-roues, et c'est justement ce qui rend le choix d'une formule moins évident qu'il n'y paraît. La marque aligne des roadsters accessibles, des sportives de haut de gamme, des trails de voyage et des maxi-scooters. Entre une 125 d'entrée dans la marque et un maxi-scooter haut de gamme, la valeur du véhicule peut varier du simple au triple, et l'occasion élargit encore l'écart."}, {"p": "Concrètement, quatre familles reviennent le plus souvent chez nos assurés."}, {"ul": ["Les roadsters MT, de la MT-125 à la MT-09, qui constituent le gros du parc assuré.", "Les sportives R, R7 et R1, dont la valeur et la puissance changent l'équation.", "Les trails Ténéré, utilisés en voyage et souvent chargés d'équipements.", "Les maxi-scooters TMAX, qui relèvent d'un usage urbain quotidien."]}, {"p": "Un même conducteur ne protège pas de la même façon un roadster d'occasion de dix ans et une sportive neuve. C'est le premier critère à poser pour choisir des garanties adaptées, avant même de comparer les assureurs."}, {"h2": "Quelle assurance selon votre modèle Yamaha ?"}, {"p": "Sur une [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-yamaha/assurance-mt-07/]]MT-07[[/LINK]], machine polyvalente et très répandue, le rapport entre la valeur du véhicule et le coût des garanties fait que la formule RC, Vol et Incendie peut suffire. La [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-yamaha/assurance-mt-09/]]MT-09[[/LINK]], plus puissante et plus chère, justifierait de monter d'un cran."}, {"p": "Sur une [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-yamaha/assurance-r1/]]R1[[/LINK]], la question ne se pose plus vraiment. La valeur de la machine, le coût des pièces de carénage et l'exposition au vol rendent une couverture complète nettement plus cohérente. Sur ce type de modèle, le risque ne vient pas seulement de la route, une chute à l'arrêt ou un vol suffisent à engager plusieurs milliers d'euros de réparation. Le [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-yamaha/assurance-t-max/]]TMAX[[/LINK]] suit sa propre logique, utilisé toute l'année et stationné dehors le plus souvent, il concentre le risque de vol et de vandalisme plutôt que celui de la vitesse."}, {"h2": "Les formules d'assurance moto Yamaha"}, {"p": "Chaque formule reprend l'intégralité des garanties de la précédente et y ajoute les siennes."}, {"table": {"head": ["<tr><th>Formule", "Dommages causés aux tiers", "Casque, gants, gilet airbag (vétusté déduite)", "Défense pénale et recours suite à accident et Protection juridique (jusqu'à 20 000 € au total)", "Vol et Incendie", "Dommages collision", "Dommages tous accidents"], "rows": [["Responsabilité civile", "oui", "oui", "oui", "non", "non", "non"], ["RC, Vol et Incendie", "oui", "oui", "oui", "oui", "non", "non"], ["Dommages collision", "oui", "oui", "oui", "oui", "oui", "non"], ["Tous risques", "oui", "oui", "oui", "oui", "oui", "oui"]]}}, {"p": "La Responsabilité civile couvre les dommages causés aux tiers lors d'un sinistre responsable. C'est le minimum obligatoire pour rouler sur la route tout en maîtrisant son budget. Dès cette première formule, le casque jusqu'à 250 euros, les gants jusqu'à 70 euros et le gilet airbag jusqu'à 500 euros sont pris en charge en cas de sinistre. La formule RC, Vol et Incendie ajoute une indemnisation en valeur de remplacement à dire d'expert. Les Dommages collision couvrent les dommages subis, déduction faite, en cas de sinistre responsable, de la franchise prévue au contrat. Le tout tient dans un seul contrat, auquel s'ajoutent les options."}, {"h2": "Les options qui complètent votre contrat"}, {"p": "Trois options complémentaires dédiées au pilote et aux équipements reviennent le plus souvent sur la gamme Yamaha."}, {"ul": ["L'Individuelle Pilote permet le versement d'un capital, jusqu'à 800 000 euros, en cas de déficit fonctionnel permanent, ou aux ayants droit en cas de décès.", "L'Option Plus indemnise votre moto en valeur d'achat pendant un an et demi et étend la couverture aux accessoires hors-série, dans la limite de 5 000 €. Sur une Ténéré équipée de valises et de protections, ou sur un TMAX avec bulle et top case, c'est ce qui fait la différence au moment du sinistre.", "L'Assistance 0 km intervient dès le premier tour de roue, y compris devant chez vous."]}, {"p": "La franchise vol est divisée par 2 si votre moto est équipée d'un gravage et d'un antivol agréé SRA, un point qui compte sur les modèles les plus recherchés de la marque."}, {"h2": "Quel est le prix d'une assurance moto Yamaha ?"}, {"p": "Le tarif dépend du modèle, de la sinistralité déclarée, du lieu de stationnement, du niveau de couverture retenu et de l'antériorité du permis. À profil identique, une MT-125 et une R1 n'aboutissent pas à la même prime, l'écart venant de la puissance, de la valeur et du coût des réparations. Le choix de la formule se fait ensuite selon la valeur de la machine, sa fréquence d'utilisation et votre budget. Un conducteur qui roule quelques milliers de kilomètres par an sur un roadster de dix ans n'a pas les mêmes besoins qu'un pilote qui sort une sportive récente chaque week-end, et la meilleure formule n'est pas la même dans les deux cas."}, {"h2": "Comment obtenir votre devis d'assurance Yamaha ?"}, {"p": "Le plus rapide reste le [[LINK:https://www.amv.fr/assurance/moto/]]devis assurance moto[[/LINK]] en ligne, en renseignant le modèle exact et votre situation. Vous pouvez souscrire dans la foulée, et le contrat court ensuite sur douze mois. Permis, carte grise et relevé d'information ne sont pas des pièces à fournir, ce sont les renseignements qu'ils contiennent qui sont nécessaires pour établir votre tarif. La souscription demande donc peu de justificatifs, et vous suivez ensuite votre contrat depuis Mon Espace AMV."}, {"h2": "Pourquoi assurer votre Yamaha chez AMV ?"}, {"p": "AMV est spécialiste de l'assurance deux-roues, fondée en 1974 par un passionné de moto, pour les motards, et compte plus d'1 million d'assurés. Plus de 350 conseillers connaissent la gamme, ce qui change la conversation quand il s'agit de savoir si une MT-07 bridée à 47,5 ch entre dans le cadre du permis A2 ou ce que couvre exactement un carénage de R7 après une chute."}, {"p": "Après plus de cinquante années passées sur le deux-roues, notre note de satisfaction est de 4,7 sur 5 sur Avis Vérifiés. Vous retrouvez d'autres marques que nous assurons sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-constructeur/]]assurance moto par constructeur[[/LINK]], sachant que la liste des modèles n'y est pas exhaustive, et nos garanties par pratique sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-type/]]assurance moto par type[[/LINK]]."}], FAQ=[{"h2": "Questions fréquentes sur l'assurance moto Yamaha"}, {"h3": "Quel est le prix d'une assurance pour une MT-07 ou une MT-09 ?"}, {"p": "Il n'existe pas de tarif unique. Le montant dépend du modèle, du lieu de stationnement, de la sinistralité déclarée, de l'antériorité du permis et de la formule choisie. Le devis en ligne donne le chiffre en quelques minutes."}, {"h3": "Peut-on assurer une Yamaha avec un permis A2 ?"}, {"p": "Oui. Plusieurs modèles de la gamme existent en version bridée à 47,5 ch, la MT-07 et la MT-09 en tête. La MT-125, elle, relève du permis A1 sans avoir besoin d'être bridée. La machine doit être conforme à la carte grise, et c'est ce document qui atteste du bridage."}, {"h3": "Les accessoires Yamaha d'origine sont-ils couverts ?"}, {"p": "Les accessoires hors-série entrent dans le périmètre de l'Option Plus, dans la limite de 5 000 €. Cela concerne aussi bien les valises d'une Ténéré que les protections de carénage montées sur une sportive."}, {"h3": "Le TMAX relève-t-il de l'assurance moto ou scooter ?"}, {"p": "C'est un maxi-scooter, il relève de notre [[LINK:https://www.amv.fr/assurance/scooter/]]assurance scooter[[/LINK]]. Les formules et les options sont construites sur la même logique, mais l'usage urbain quotidien déplace le curseur vers le vol et le vandalisme."}, {"h3": "Que couvre l'assurance en cas de vol de ma Yamaha ?"}, {"p": "À partir de la formule RC, Vol et Incendie, le vol est garanti sous réserve d'effraction, d'escalade ou d'usage de fausses clés lorsque la moto est dans un local privé fermé à clé. L'indemnisation se fait en valeur de remplacement à dire d'expert, et le dépôt de plainte conditionne le dossier."}, {"h3": "Faut-il déclarer une modification sur sa moto Yamaha ?"}, {"p": "Oui, toute modification qui change les caractéristiques du véhicule doit être déclarée, un échappement homologué comme un débridage. Un véhicule non conforme à sa carte grise sort du cadre du contrat, ce qui est le vrai risque sur une assurance moto Yamaha."}], STRIKE=["KTM : une épopée mécanique autrichienne, de ses origines hum","La renommée de KTM repose principalement sur ses motos tout-","KTM de 1953 à 1991 En 1953, l'homme d'affaires Ernst Kronrei","Ernst Kronreif décède en 1960. Deux ans plus tard, en 1962, ","En 1978, la filiale américaine KTM North America Inc. est fo","KTM après 1991 En 1991, l'entreprise est scindée en quatre e","En 1995, KTM Motorradholding GmbH a acquis le fabricant suéd","En 2007, le fabricant indien de motos Bajaj Auto a acquis un","En 2013, KTM a racheté le fabricant de motos suédois Husqvar","La restructuration de l'entreprise dans les années 1990 a ét","Comment assurer sa moto ?","Bien assurer votre moto est essentiel pour prendre la route ","AMV propose la souscription simple et rapide en ligne vous p","AMV propose une gamme complète de formules d'assurance moto ","En cas de sinistre, AMV met à votre disposition un service d","Experts de l'assurance moto, les conseillers AMV sont des pa","En choisissant AMV comme assureur pour votre moto , vous bén","Quand KTM a-t-elle &#xE9;t&#xE9; fond&#xE9;e et par qui ?","KTM a été fondée en 1934 par l'ingénieur autrichien Johann (","Quels &#xE9;v&#xE9;nements ont marqu&#xE9; le tournant dans ","Les années 1990 ont été marquées par une restructuration maj","Quelles acquisitions strat&#xE9;giques ont contribu&#xE9; &#","En 2007, Bajaj Auto a acquis une participation importante da","Quelle assurance moto choisir ?","Quel est le prix d'une assurance moto ?","Quelle formule assurance moto choisir ?","Comment obtenir un devis d'assurance moto ?","Pour obtenir un devis d'assurance moto rapidement, AMV est v","Assurance pour les mod&#xE8;les KTM"], OFFTOPIC=[];
  function norm(s){return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[\u2019\u2018\u02bc\u0060\u00b4\u2032]/g,"'").replace(/\s+/g," ");}
  function lnk(s){return (s||"").replace(/\[\[LINK:([^\]]*)\]\]([\s\S]*?)\[\[\/LINK\]\]/g,'<a href="$1" target="_blank" rel="noopener">$2</a>');}
  function el(tag,cls,h){var e=document.createElement(tag);if(cls)e.className=cls;if(h!=null)e.innerHTML=h;return e;}
  function renderItems(items){var frag=document.createDocumentFragment();items.forEach(function(it){
    if(it.h2)frag.appendChild(el("h2","rl-nh rl-nh2",lnk(it.h2)));
    else if(it.h3)frag.appendChild(el("h3","rl-nh rl-nh3",lnk(it.h3)));
    else if(it.p)frag.appendChild(el("p","rl-np",lnk(it.p)));
    else if(it.note){var c=el("div","rl-callout",null);c.appendChild(el("span","rl-callout-ic","✓"));c.appendChild(el("span","rl-callout-tx",lnk(it.note)));frag.appendChild(c);}
    else if(it.cta){var a=el("a","rl-cta",it.cta.label);a.setAttribute("href",it.cta.href);a.setAttribute("target","_blank");a.setAttribute("rel","noopener");frag.appendChild(a);}
    else if(it.ul){var ul=el("ul","rl-nul",null);it.ul.forEach(function(li){ul.appendChild(el("li",null,lnk(li)));});frag.appendChild(ul);}
    else if(it.table){var t=el("table","rl-table",null);var th=el("thead",null,null),tr=el("tr",null,null);it.table.head.forEach(function(h){tr.appendChild(el("th",null,h));});th.appendChild(tr);t.appendChild(th);var tb=el("tbody",null,null);it.table.rows.forEach(function(r){var row=el("tr",null,null);r.forEach(function(c){row.appendChild(el("td",null,c));});tb.appendChild(row);});t.appendChild(tb);frag.appendChild(t);}
  });return frag;}
  function block(items){var box=el("div","rl-add",null);box.appendChild(el("span","rl-badge","Nouvelle page proposee"));box.appendChild(renderItems(items));return box;}
  function findByText(sel,text){var n=norm(text);var l=[].slice.call(document.querySelectorAll(sel));for(var i=0;i<l.length;i++){if(norm(l[i].textContent).indexOf(n)>=0)return l[i];}return null;}
  function insertAfter(node,ref){ref.parentNode.insertBefore(node,ref.nextSibling);}
  function insertBefore(node,ref){ref.parentNode.insertBefore(node,ref);}
  function apply(){
    var h1=document.querySelector("h1");
    if(H1&&h1&&!h1.getAttribute("data-rl")){h1.setAttribute("data-rl","1");var nh=el("div","rl-add rl-inline",null);nh.id="rl-h1box";nh.appendChild(el("span","rl-badge","H1 propose"));nh.appendChild(el("span","rl-h1",H1));insertAfter(nh,h1);}
    if(h1&&!document.getElementById("rl-body")){var bb=block(BODY);bb.id="rl-body";var hero=h1.closest(".gap-amv40")||h1.closest("section")||h1.closest(".umb-block-list")||h1;insertAfter(bb,hero);}
    if(FAQ&&FAQ.length&&!document.getElementById("rl-faq")){
      var af=findByText("h2","questions fr");
      var bf=block(FAQ);bf.id="rl-faq";
      if(af){var fs=af.closest("section")||af;insertBefore(bf,fs);}
      else{var b=document.getElementById("rl-body");if(b)insertAfter(bf,b);}
    }
    if(!window.__rlStruck){var n=0;var faqH=findByText("h2","questions fr");[].slice.call(document.querySelectorAll("h2,h3,h4,p,li")).forEach(function(e){
      if(e.closest(".rl-add"))return;
      /* creation : la FAQ existante du template est masquee elle aussi */
      var t=norm(e.textContent);
      for(var i=0;i<STRIKE.length;i++){if(STRIKE[i]&&t.indexOf(norm(STRIKE[i]))>=0){e.style.display="none";n++;break;}}
    });if(n)window.__rlStruck=true;}
    if(OFFTOPIC&&OFFTOPIC.length&&!window.__rlOff){var faqH2=findByText("h2","questions fr");if(faqH2){var m=0;[].slice.call(document.querySelectorAll("h2,h3,p,li,span,.collapse-part")).forEach(function(e){if(e.closest(".rl-add"))return;if(e.closest(".rl-offtopic"))return;if(!(faqH2===e||(faqH2.compareDocumentPosition(e)&4)))return;var t=norm(e.textContent);for(var j=0;j<OFFTOPIC.length;j++){if(OFFTOPIC[j]&&t.indexOf(norm(OFFTOPIC[j]))>=0){e.classList.add("rl-offtopic");m++;break;}}});if(m)window.__rlOff=true;}}

    /* --- mode creation --- */
    var box=document.querySelector("main > div.mx-auto");
    if(box&&!window.__rlCrea){
      var kids=[].slice.call(box.children);
      kids.forEach(function(k,i){
        if(i<2)return;                            /* fil d'ariane + hero */
        if(k.classList.contains("rl-add"))return; /* notre contenu */
        if(k.querySelector&&k.querySelector(".rl-add"))return;
        if(i===kids.length-1)return;              /* pagination de bas de page */
        k.classList.add("rl-del");
      });
      var hh=document.querySelector("h1");
      if(hh&&H1){hh.textContent=H1;}
      var bc=box.children[0];
      if(bc){var last=bc.lastElementChild;if(last)last.textContent=H1;}
      if(H1)document.title=H1+" | AMV";
      var hb=document.getElementById("rl-h1box");if(hb)hb.style.display="none";
      /* le visuel de marque du gabarit n'a rien a faire sur une autre marque */
      var hero=hh?(hh.closest(".gap-amv40")||hh.parentElement.parentElement):null;
      if(hero){[].slice.call(hero.querySelectorAll("img,picture")).forEach(function(im){im.classList.add("rl-del");});}
      window.__rlCrea=true;
    }
    return !!(h1&&document.getElementById("rl-body"));
  }
  function addControls(){if(document.getElementById("rl-toggle"))return;var b=el("button",null,'<span class="dot"></span> Voir les modifications');b.id="rl-toggle";b.addEventListener("click",function(){var d=document.body,on=d.classList.toggle("rl-on");d.classList.toggle("rl-final",!on);b.innerHTML='<span class="dot"></span> '+(on?"Version finale":"Voir les modifications");});document.body.appendChild(b);var lg=el("div",null,'<span class="sw sw-add"></span> Nouvelle page proposee (creation, template AMV)');lg.id="rl-legend";document.body.appendChild(lg);document.body.classList.add("rl-final");}
  function init(){addControls();var t=0;var tm=setInterval(function(){t++;if(apply()||t>40){clearInterval(tm);}},250);}
  if(document.readyState==="complete"||document.readyState==="interactive")init();else document.addEventListener("DOMContentLoaded",init);
})();

/* --- correctif scroll (ajoute le 2026-08-20) ---------------------------------
   Un script du site ajoute la classe `tc-modal-open` au body au chargement.
   La regle `body.tc-modal-open{inset:0;position:fixed;overflow:hidden}` verrouille
   alors le scroll, alors qu'aucune modale n'existe dans la capture. On retire la
   classe, on neutralise la regle, et un observer la retire si un script la remet. */
(function(){
  var css=document.createElement('style');
  css.textContent='body.tc-modal-open{position:static !important;inset:auto !important;overflow:visible !important;height:auto !important;}';
  (document.head||document.documentElement).appendChild(css);
  function unlock(){
    var b=document.body; if(!b) return;
    b.classList.remove('tc-modal-open');
    if(getComputedStyle(b).position==='fixed'){ b.style.setProperty('position','static','important'); b.style.setProperty('overflow','visible','important'); b.style.setProperty('height','auto','important'); }
  }
  function watch(){
    unlock();
    try{ new MutationObserver(unlock).observe(document.body,{attributes:true,attributeFilter:['class','style']}); }catch(e){}
  }
  if(document.body) watch(); else document.addEventListener('DOMContentLoaded',watch);
  window.addEventListener('load',unlock);
  setTimeout(unlock,1500); setTimeout(unlock,4000);
})();
