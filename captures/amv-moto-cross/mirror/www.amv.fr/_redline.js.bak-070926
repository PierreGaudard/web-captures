// Maquette AMV : AMV - Assurance moto cross (reoptimisation) (gabarit amv-moto-bmw, contenu du gabarit masque).
// Page proposee : /assurance-moto/assurance-moto-cross/
(function(){
  var H1="Assurance moto cross", BODY=[{"p": "En résumé, une assurance moto cross dépend d'abord d'une question administrative. Si la machine n'est pas homologuée, seule une formule Responsabilité civile dédiée est proposée, et elle ne roule que sur terrain privé ou sur circuit. Si elle est homologuée et immatriculée, elle accède aux mêmes formules qu'une moto classique. Le roulage libre sur circuit est autorisé, alors que la compétition n'est jamais couverte. Découvrez comment choisir selon votre pratique."}, {"h2": "Moto cross homologuée ou non, la question qui détermine tout"}, {"p": "Deux machines qui se ressemblent au point de tromper l'oeil ne relèvent pas du même contrat. Une moto cross de compétition, une 250 quatre temps sortie du carton pour le terrain, n'a ni plaque, ni éclairage, ni carte grise. Elle n'est pas homologuée pour la route, donc elle ne peut pas y circuler, et les garanties qu'un assureur peut proposer sont limitées à ce que la réglementation permet."}, {"p": "À côté, une enduro homologuée dispose d'une carte grise, d'un éclairage et d'une plaque. Elle circule légalement et accède aux formules classiques. C'est la première information à vérifier, elle figure sur votre certificat d'immatriculation."}, {"p": "L'obligation d'assurance ne dépend pas de l'homologation. L'article L211-1 du code des assurances impose une responsabilité civile à qui fait circuler un véhicule terrestre à moteur, défini comme tout véhicule automoteur destiné à circuler sur le sol. Le texte ne distingue pas la voie publique de la propriété privée. Une moto cross doit ainsi être couverte, même sans carte grise, et vos besoins se définissent ensuite selon la pratique."}, {"h2": "Quelle assurance pour une moto cross non homologuée ?"}, {"p": "Pour une machine non homologuée, AMV propose uniquement une formule Responsabilité civile dédiée. Elle couvre les dommages causés aux tiers lors d'un sinistre responsable, ce qui correspond au risque principal de la pratique, à savoir la collision avec un autre pilote ou le dommage causé à un spectateur ou à un tiers présent sur le terrain."}, {"p": "Pour la compétition, c'est la licence fédérale qui porte la responsabilité civile de l'épreuve. Elle ne remplace pas l'assurance du véhicule en dehors des épreuves."}, {"p": "Il n'y a pas de formule Vol et Incendie, ni de Dommages collision, ni de Tous risques sur ce type de véhicule. C'est une limite à connaître avant l'achat, parce qu'une 450 récente représente plusieurs milliers d'euros que le contrat ne couvre pas contre le vol. La question du stockage se traite alors avec l'assureur du logement, la garantie multirisque habitation pouvant couvrir un véhicule remisé selon les termes du contrat."}, {"p": "Les informations à réunir pour souscrire assurance moto sont simples, la marque, le modèle, la cylindrée et le type de pratique. En cas accident sur le terrain, la déclaration suit le circuit habituel, avec un constat si un tiers est impliqué."}, {"h2": "Les formules pour une moto cross homologuée"}, {"p": "Une cross ou une enduro homologuée relève des mêmes formules qu'une moto classique. Chaque formule reprend l'intégralité des garanties de la précédente et y ajoute les siennes."}, {"table": {"head": ["<tr><th>Formule", "Dommages causés aux tiers", "Casque, gants, gilet airbag (vétusté déduite)", "Défense pénale et recours suite à accident et Protection juridique (jusqu'à 20 000 € au total)", "Vol et Incendie", "Dommages collision", "Dommages tous accidents"], "rows": [["Responsabilité civile", "oui", "oui", "oui", "non", "non", "non"], ["RC, Vol et Incendie", "oui", "oui", "oui", "oui", "non", "non"], ["Dommages collision", "oui", "oui", "oui", "oui", "oui", "non"], ["Tous risques", "oui", "oui", "oui", "oui", "oui", "oui"]]}}, {"p": "La Responsabilité civile est le minimum obligatoire pour rouler sur la route tout en maîtrisant son budget. Dès cette première formule, le casque jusqu'à 250 euros, les gants jusqu'à 70 euros et le gilet airbag jusqu'à 500 euros sont pris en charge. La formule RC, Vol et Incendie ajoute l'indemnisation en valeur de remplacement à dire d'expert. Les Dommages collision couvrent les dommages subis, déduction faite, en cas de sinistre responsable, de la franchise prévue au contrat. AMV propose jusqu'à quatre formules, selon les modèles, réunies dans un seul contrat auquel s'ajoutent les options."}, {"p": "Sur une machine tout-terrain qui alterne route et chemins, la formule RC, Vol et Incendie peut suffire, alors qu'une trail récente utilisée en voyage justifierait un niveau supérieur. Le choix se fait selon la valeur de la machine, sa fréquence d'utilisation et votre budget."}, {"h2": "Rouler sur circuit, en terrain privé ou en compétition"}, {"p": "C'est le sujet qui génère le plus de malentendus, et la réponse dépend du cadre exact de la sortie."}, {"ul": ["Le roulage libre sur circuit est autorisé et la Responsabilité civile reste acquise, à condition que la sortie soit ponctuelle, à titre personnel, hors classement et hors chronométrage.", "La compétition n'est jamais couverte, quelle que soit la formule souscrite. Une course, un championnat, une épreuve chronométrée sortent du contrat, et c'est la licence fédérale qui prend le relais.", "Un circuit se définit comme un itinéraire fermé qui ne peut emprunter que des voies fermées, de manière permanente ou temporaire, à la circulation publique. Un chemin forestier ouvert n'en est pas un.", "Sur un terrain privé, la Responsabilité civile reste la bonne réponse, parce que votre responsabilité personnelle est engagée dès qu'un tiers est présent sur place, un autre pilote comme un spectateur."]}, {"p": "Notre article sur les [[LINK:https://www.amv.fr/assurance-moto/cross-et-enduro-quelles-sont-les-differences/]]différences entre cross et enduro[[/LINK]] détaille ce que change la conduite en compétition, et nous répondons dans un guide dédié à la question de [[LINK:https://www.amv.fr/assurance-moto/je-pratique-lenduro-suis-je-couvert-par-mon-assurance-moto/]]savoir si l'enduro est couvert par votre assurance moto[[/LINK]]."}, {"h2": "Le vol, dans le garage comme dans le van"}, {"p": "Une moto cross passe sa vie entre un garage et une remorque, et c'est là qu'elle disparaît. Une machine qui se charge à deux dans un utilitaire et qui n'a pas de clé de contact à forcer demande une vigilance particulière sur le lieu de stockage."}, {"p": "Sur une machine homologuée couverte en vol incendie, le vol dans un local privé fermé à clé est garanti sous réserve d'effraction, d'escalade ou d'usage de fausses clés. La franchise vol est divisée par 2 avec un gravage et un antivol agréé SRA, et le dépôt de plainte conditionne l'indemnisation. L'assistance, elle, ne couvre pas le rapatriement depuis un terrain fermé."}, {"h2": "Quel est le prix d'une assurance moto cross ?"}, {"p": "Le coût dépend du modèle, de la sinistralité déclarée, du lieu de stationnement, du niveau de couverture retenu et de l'antériorité du permis. À profil identique, une formule Responsabilité civile pour une machine non homologuée coûte nettement moins cher qu'un contrat complet sur une enduro immatriculée, puisque le périmètre des garanties n'a rien de comparable."}, {"p": "Permis, carte grise et relevé d'information ne sont pas des pièces à fournir, ce sont les renseignements qu'ils contiennent qui sont nécessaires pour établir votre tarif. La souscription demande donc peu de justificatifs. Pour connaître votre tarif, établissez votre [[LINK:https://www.amv.fr/assurance/moto/]]devis assurance moto[[/LINK]] en ligne, puis suivez votre contrat depuis Mon Espace AMV."}, {"h2": "Pourquoi assurer votre moto cross chez AMV ?"}, {"p": "AMV est spécialiste de l'assurance deux-roues, fondée en 1974 par un passionné de moto, pour les motards, et compte plus d'1 million d'assurés. Le tout-terrain fait partie des pratiques que nos conseillers traitent au quotidien, ce qui compte quand la question porte sur l'éligibilité d'une machine non homologuée ou sur le cadre d'un roulage."}, {"p": "Deux options complémentaires dédiées au pilote et aux équipements méritent l'attention sur une pratique tout-terrain."}, {"ul": ["L'Individuelle Pilote permet le versement d'un capital, jusqu'à 800 000 euros, en cas de déficit fonctionnel permanent, ou aux ayants droit en cas de décès. Sur une discipline où la chute fait partie du jeu, c'est l'option la plus pertinente.", "L'Option Plus indemnise votre moto en valeur d'achat pendant un an et demi et étend la couverture aux accessoires hors-série, dans la limite de 5 000 €."]}, {"p": "Plus de 350 conseillers répondent sur ces sujets, et notre note de satisfaction est de 4,7 sur 5 sur Avis Vérifiés. Vous retrouvez nos garanties par pratique sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-type/]]assurance moto par type[[/LINK]], nos contenus par marque sur la page [[LINK:https://www.amv.fr/assurance-moto/assurance-moto-par-constructeur/]]assurance moto par constructeur[[/LINK]], et notre page dédiée à l'[[LINK:https://www.amv.fr/assurance-moto/assurance-moto-enduro/]]assurance moto enduro[[/LINK]] pour les machines homologuées."}], FAQ=[{"h2": "Questions fréquentes sur l'assurance moto cross"}, {"h3": "Une moto cross non homologuée doit-elle être assurée ?"}, {"p": "Oui dès qu'elle circule ailleurs que sur une propriété entièrement close. Un terrain ouvert à plusieurs pratiquants impose la Responsabilité civile, même sans immatriculation. AMV propose une formule Responsabilité civile dédiée à ces véhicules."}, {"h3": "Peut-on assurer une moto cross contre le vol ?"}, {"p": "Sur une machine non homologuée, non, seule la Responsabilité civile est proposée. Sur une cross ou une enduro homologuée et immatriculée, la formule RC, Vol et Incendie couvre le vol dans un local fermé à clé sous réserve d'effraction."}, {"h3": "Suis-je couvert si je roule sur un circuit ?"}, {"p": "Le roulage libre sur circuit est autorisé et la Responsabilité civile reste acquise, à condition que la sortie soit ponctuelle, personnelle, hors classement et hors chronométrage. Dès qu'il y a compétition, elle n'est jamais couverte."}, {"h3": "Faut-il un permis pour une moto cross ?"}, {"p": "Pas pour rouler sur un terrain privé ou lors d'un roulage encadré, où seule la conduite hors voie publique est en jeu. En revanche une machine homologuée circulant sur la route exige le permis correspondant à sa cylindrée."}, {"h3": "Le quad tout-terrain suit-il les mêmes règles ?"}, {"p": "La logique est identique, l'homologation détermine les garanties possibles. Pour un quad non homologué, seule une formule Responsabilité civile dédiée est proposée, comme pour une assurance moto cross."}], STRIKE=["KTM : une épopée mécanique autrichienne, de ses origines hum","La renommée de KTM repose principalement sur ses motos tout-","KTM de 1953 à 1991 En 1953, l'homme d'affaires Ernst Kronrei","Ernst Kronreif décède en 1960. Deux ans plus tard, en 1962, ","En 1978, la filiale américaine KTM North America Inc. est fo","KTM après 1991 En 1991, l'entreprise est scindée en quatre e","En 1995, KTM Motorradholding GmbH a acquis le fabricant suéd","En 2007, le fabricant indien de motos Bajaj Auto a acquis un","En 2013, KTM a racheté le fabricant de motos suédois Husqvar","La restructuration de l'entreprise dans les années 1990 a ét","Comment assurer sa moto ?","Bien assurer votre moto est essentiel pour prendre la route ","AMV propose la souscription simple et rapide en ligne vous p","AMV propose une gamme complète de formules d'assurance moto ","En cas de sinistre, AMV met à votre disposition un service d","Experts de l'assurance moto, les conseillers AMV sont des pa","En choisissant AMV comme assureur pour votre moto , vous bén","Quand KTM a-t-elle &#xE9;t&#xE9; fond&#xE9;e et par qui ?","KTM a été fondée en 1934 par l'ingénieur autrichien Johann (","Quels &#xE9;v&#xE9;nements ont marqu&#xE9; le tournant dans ","Les années 1990 ont été marquées par une restructuration maj","Quelles acquisitions strat&#xE9;giques ont contribu&#xE9; &#","En 2007, Bajaj Auto a acquis une participation importante da","Quelle assurance moto choisir ?","Quel est le prix d'une assurance moto ?","Quelle formule assurance moto choisir ?","Comment obtenir un devis d'assurance moto ?","Pour obtenir un devis d'assurance moto rapidement, AMV est v","Assurance pour les mod&#xE8;les KTM"], OFFTOPIC=[];
  function norm(s){return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[\u2019\u2018\u02bc\u0060\u00b4\u2032]/g,"'").replace(/\s+/g," ");}
  function lnk(s){return (s||"").replace(/\[\[LINK:([^\]]*)\]\]([\s\S]*?)\[\[\/LINK\]\]/g,'<a href="$1" target="_blank" rel="noopener">$2</a>');}
  function el(tag,cls,h){var e=document.createElement(tag);if(cls)e.className=cls;if(h!=null)e.innerHTML=h;return e;}
  function renderItems(items){var frag=document.createDocumentFragment();items.forEach(function(it){
    if(it.h2)frag.appendChild(el("h2","rl-nh rl-nh2",lnk(it.h2)));
    else if(it.h3)frag.appendChild(el("h3","rl-nh rl-nh3",lnk(it.h3)));
    else if(it.p)frag.appendChild(el("p","rl-np",lnk(it.p)));
    else if(it.note){var c=el("div","rl-callout",null);c.appendChild(el("span","rl-callout-ic","✓"));c.appendChild(el("span","rl-callout-tx",lnk(it.note)));frag.appendChild(c);}
    else if(it.cta){var a=el("a","rl-cta",it.cta.label);a.setAttribute("href",it.cta.href);a.setAttribute("target","_blank");a.setAttribute("rel","noopener");frag.appendChild(a);}
    else if(it.ul){var ul=el("ul","rl-nul",null);it.ul.forEach(function(li){ul.appendChild(el("li",null,lnk(li)));});frag.appendChild(ul);}
    else if(it.table){var t=el("table","rl-table",null);var th=el("thead",null,null),tr=el("tr",null,null);it.table.head.forEach(function(h){tr.appendChild(el("th",null,h));});th.appendChild(tr);t.appendChild(th);var tb=el("tbody",null,null);it.table.rows.forEach(function(r){var row=el("tr",null,null);r.forEach(function(c){row.appendChild(el("td",null,c));});tb.appendChild(row);});t.appendChild(tb);frag.appendChild(t);}
  });return frag;}
  function block(items){var box=el("div","rl-add",null);box.appendChild(el("span","rl-badge","Nouvelle page proposee"));box.appendChild(renderItems(items));return box;}
  function findByText(sel,text){var n=norm(text);var l=[].slice.call(document.querySelectorAll(sel));for(var i=0;i<l.length;i++){if(norm(l[i].textContent).indexOf(n)>=0)return l[i];}return null;}
  function insertAfter(node,ref){ref.parentNode.insertBefore(node,ref.nextSibling);}
  function insertBefore(node,ref){ref.parentNode.insertBefore(node,ref);}
  function apply(){
    var h1=document.querySelector("h1");
    if(H1&&h1&&!h1.getAttribute("data-rl")){h1.setAttribute("data-rl","1");var nh=el("div","rl-add rl-inline",null);nh.id="rl-h1box";nh.appendChild(el("span","rl-badge","H1 propose"));nh.appendChild(el("span","rl-h1",H1));insertAfter(nh,h1);}
    if(h1&&!document.getElementById("rl-body")){var bb=block(BODY);bb.id="rl-body";var hero=h1.closest(".gap-amv40")||h1.closest("section")||h1.closest(".umb-block-list")||h1;insertAfter(bb,hero);}
    if(FAQ&&FAQ.length&&!document.getElementById("rl-faq")){
      var af=findByText("h2","questions fr");
      var bf=block(FAQ);bf.id="rl-faq";
      if(af){var fs=af.closest("section")||af;insertBefore(bf,fs);}
      else{var b=document.getElementById("rl-body");if(b)insertAfter(bf,b);}
    }
    if(!window.__rlStruck){var n=0;var faqH=findByText("h2","questions fr");[].slice.call(document.querySelectorAll("h2,h3,h4,p,li")).forEach(function(e){
      if(e.closest(".rl-add"))return;
      /* creation : la FAQ existante du template est masquee elle aussi */
      var t=norm(e.textContent);
      for(var i=0;i<STRIKE.length;i++){if(STRIKE[i]&&t.indexOf(norm(STRIKE[i]))>=0){e.style.display="none";n++;break;}}
    });if(n)window.__rlStruck=true;}
    if(OFFTOPIC&&OFFTOPIC.length&&!window.__rlOff){var faqH2=findByText("h2","questions fr");if(faqH2){var m=0;[].slice.call(document.querySelectorAll("h2,h3,p,li,span,.collapse-part")).forEach(function(e){if(e.closest(".rl-add"))return;if(e.closest(".rl-offtopic"))return;if(!(faqH2===e||(faqH2.compareDocumentPosition(e)&4)))return;var t=norm(e.textContent);for(var j=0;j<OFFTOPIC.length;j++){if(OFFTOPIC[j]&&t.indexOf(norm(OFFTOPIC[j]))>=0){e.classList.add("rl-offtopic");m++;break;}}});if(m)window.__rlOff=true;}}

    /* --- mode creation --- */
    var box=document.querySelector("main > div.mx-auto");
    if(box&&!window.__rlCrea){
      var kids=[].slice.call(box.children);
      kids.forEach(function(k,i){
        if(i<2)return;                            /* fil d'ariane + hero */
        if(k.classList.contains("rl-add"))return; /* notre contenu */
        if(k.querySelector&&k.querySelector(".rl-add"))return;
        if(i===kids.length-1)return;              /* pagination de bas de page */
        k.classList.add("rl-del");
      });
      var hh=document.querySelector("h1");
      if(hh&&H1){hh.textContent=H1;}
      var bc=box.children[0];
      if(bc){var last=bc.lastElementChild;if(last)last.textContent=H1;}
      if(H1)document.title=H1+" | AMV";
      var hb=document.getElementById("rl-h1box");if(hb)hb.style.display="none";
      /* le visuel de marque du gabarit n'a rien a faire sur une autre marque */
      var hero=hh?(hh.closest(".gap-amv40")||hh.parentElement.parentElement):null;
      if(hero){[].slice.call(hero.querySelectorAll("img,picture")).forEach(function(im){im.classList.add("rl-del");});}
      window.__rlCrea=true;
    }
    return !!(h1&&document.getElementById("rl-body"));
  }
  function addControls(){if(document.getElementById("rl-toggle"))return;var b=el("button",null,'<span class="dot"></span> Voir les modifications');b.id="rl-toggle";b.addEventListener("click",function(){var d=document.body,on=d.classList.toggle("rl-on");d.classList.toggle("rl-final",!on);b.innerHTML='<span class="dot"></span> '+(on?"Version finale":"Voir les modifications");});document.body.appendChild(b);var lg=el("div",null,'<span class="sw sw-add"></span> Nouvelle page proposee (creation, template AMV)');lg.id="rl-legend";document.body.appendChild(lg);document.body.classList.add("rl-final");}
  function init(){addControls();var t=0;var tm=setInterval(function(){t++;if(apply()||t>40){clearInterval(tm);}},250);}
  if(document.readyState==="complete"||document.readyState==="interactive")init();else document.addEventListener("DOMContentLoaded",init);
})();

/* --- correctif scroll (ajoute le 2026-08-20) ---------------------------------
   Un script du site ajoute la classe `tc-modal-open` au body au chargement.
   La regle `body.tc-modal-open{inset:0;position:fixed;overflow:hidden}` verrouille
   alors le scroll, alors qu'aucune modale n'existe dans la capture. On retire la
   classe, on neutralise la regle, et un observer la retire si un script la remet. */
(function(){
  var css=document.createElement('style');
  css.textContent='body.tc-modal-open{position:static !important;inset:auto !important;overflow:visible !important;height:auto !important;}';
  (document.head||document.documentElement).appendChild(css);
  function unlock(){
    var b=document.body; if(!b) return;
    b.classList.remove('tc-modal-open');
    if(getComputedStyle(b).position==='fixed'){ b.style.setProperty('position','static','important'); b.style.setProperty('overflow','visible','important'); b.style.setProperty('height','auto','important'); }
  }
  function watch(){
    unlock();
    try{ new MutationObserver(unlock).observe(document.body,{attributes:true,attributeFilter:['class','style']}); }catch(e){}
  }
  if(document.body) watch(); else document.addEventListener('DOMContentLoaded',watch);
  window.addEventListener('load',unlock);
  setTimeout(unlock,1500); setTimeout(unlock,4000);
})();
